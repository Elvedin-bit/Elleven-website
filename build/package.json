{
  "name": "elleven-website-build",
  "private": true,
  "version": "1.0.0",
  "description": "Build-gereedschap voor de Elleven-website. Staat bewust in een aparte map: de repo-root is de gepubliceerde site, en Netlify mag hier niets auto-detecteren.",
  "scripts": {
    "build": "npm run build:css && npm run build:vendor && npm run build:fonts",
    "build:css": "tailwindcss -c tailwind.config.js -i ../src/css/input.css -o ../styles.css --minify",
    "build:vendor": "cp node_modules/gsap/dist/gsap.min.js node_modules/gsap/dist/ScrollTrigger.min.js ../vendor/",
    "build:fonts": "cp node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2 ../fonts/inter-latin-wght-5.3.0.woff2 && cp node_modules/@fontsource-variable/inter/LICENSE ../fonts/inter-LICENSE.txt",
    "watch:css": "tailwindcss -c tailwind.config.js -i ../src/css/input.css -o ../styles.css --watch"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "gsap": "3.13.0",
    "tailwindcss": "3.4.17"
  }
}
